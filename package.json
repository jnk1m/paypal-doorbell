{
  "name": "paypal-doorbell",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx scripts/build-diffs.ts && next dev",
    "build": "tsx scripts/build-diffs.ts && next build",
    "start": "next start",
    "test": "find lib eval/harness scripts -name '*.test.ts' ! -name '*.sandbox.test.ts' ! -name '*.redis.test.ts' | xargs tsx --test",
    "eval:dev": "tsx eval/harness/run.ts --set eval/dev --runs 3",
    "test:redis": "find lib -name '*.redis.test.ts' | xargs tsx --test",
    "ledger": "tsx scripts/numbers-ledger.ts",
    "typecheck": "tsx scripts/build-diffs.ts && tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.82",
    "@paypal/agent-toolkit": "1.11.0",
    "@upstash/redis": "^1.39.0",
    "ai": "^7.0.143",
    "next": "^16.4.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.0"
  }
}
