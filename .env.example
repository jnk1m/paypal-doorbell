# PayPal Sandbox app keys (Sandbox only; the client refuses any other base URL).
# On the developer's machine these are the DEV app (Default Application). On Vercel production they are the DEMO app's keys:
# the deployed site acts as the demo app, whose webhooks are frozen (fixtures/demo-webhooks.frozen.json).
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# The demo app "Doorbell Demo" (app_id APP-4SF2883699350514P), for scripts that act as it (scripts/webhook.ts --app demo, cross-app.ts, s2-acceptance.ts).
PAYPAL_DEMO_CLIENT_ID=
PAYPAL_DEMO_CLIENT_SECRET=
# Id of the witness webhook D (npx tsx scripts/webhook.ts --app demo register <url>/api/witness). The receiver reads it from here; so does the shop's
# wrong-webhook-ID mode (lib/shop/config.ts), which checks the shop's deliveries against this id on purpose, so that every one fails.
PAYPAL_WITNESS_WEBHOOK_ID=
# Optional: another Sandbox app's witness webhook that delivers to the same URL (the dev app's). Verify is not tied to the app, so one client serves both.
PAYPAL_WITNESS_DEV_WEBHOOK_ID=
# Id of the shop webhook S (<url>/api/shop/webhook, subscribed to PAYMENT.CAPTURE.COMPLETED and PAYMENT.CAPTURE.REFUNDED).
PAYPAL_SHOP_WEBHOOK_ID=
# The live shop is closed unless this is set: every shop API call must send it as X-Live-Token. Kept in .env.live for the scripts.
DOORBELL_LIVE_TOKEN=
# Upstash Redis (Vercel Marketplace integration). Kept in .env.vercel for local scripts; keys are prefixed db:
KV_REST_API_URL=
KV_REST_API_TOKEN=
ANTHROPIC_API_KEY=
